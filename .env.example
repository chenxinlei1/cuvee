DATABASE_URL=postgresql://cuvee:cuvee-local@127.0.0.1:5432/cuvee
CUVEE_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CUVEE_SEED_DEMO_USERS=false

# Email verification and password reset. Without these, local development
# prints links to the server console and returns a clickable development URL.
RESEND_API_KEY=
CUVEE_MAIL_FROM=Cuvée <security@example.com>

# Select one LLM provider; retrieval is optional.
CUVEE_LLM_PROVIDER=openai
OPENAI_API_KEY=
TAVILY_API_KEY=
