DATABASE_URL=postgresql://cuvee:cuvee-local@127.0.0.1:5432/cuvee
CUVEE_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CUVEE_DOWNLOAD_SECRET=replace-with-an-independent-random-secret
CUVEE_SEED_DEMO_USERS=false

# Email verification and password reset. Without these, local development
# prints links to the server console and returns a clickable development URL.
RESEND_API_KEY=
CUVEE_MAIL_FROM=Cuvée <security@example.com>
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
CUVEE_METRICS_TOKEN=
CUVEE_DATA_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_DIR=/backups
BACKUP_HOST_DIR=./backups

# Async analysis task queue (in-process worker, PostgreSQL-backed).
CUVEE_WORKER_ENABLED=true
CUVEE_WORKER_CONCURRENCY=2
CUVEE_WORKER_POLL_MS=1500
CUVEE_WORKER_STALE_MS=60000
CUVEE_TASK_TTL_MS=86400000

# Source-map upload during CI builds (withSentryConfig enables upload only
# when this token is present). Leave empty to skip source-map upload.
SENTRY_AUTH_TOKEN=

# Select one LLM provider; retrieval is optional.
CUVEE_LLM_PROVIDER=openai
OPENAI_API_KEY=
TAVILY_API_KEY=
