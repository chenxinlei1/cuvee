{
  "name": "cuvee",
  "version": "0.1.0",
  "private": true,
  "description": "Schema-grounded multi-agent vintage intelligence for Burgundy + Bordeaux with critic-backed backtest verification.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--no-warnings WATCHPACK_POLLING=true next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/check-env.ts",
    "test:geo": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-geo-agent.ts",
    "test:weather": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-weather-agent.ts",
    "test:rbac": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-rbac-isolation.ts",
    "test:report-auth": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-report-authorization.ts",
    "test:tasks": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-task-queue.ts",
    "test:org-admin": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-org-admin.ts",
    "test:security": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-security.ts",
    "test:unit": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/test-unit.ts",
    "test:backup": "sh scripts/test-backup-restore.sh",
    "test": "pnpm test:security && pnpm test:unit && pnpm test:rbac && pnpm test:report-auth && pnpm test:tasks && pnpm test:org-admin",
    "db:backup": "docker compose run --rm -e BACKUP_LOOP=false backup",
    "db:restore": "sh scripts/restore-postgres.sh",
    "export:tavily-cache": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/export-tavily-cache.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:import-sqlite": "node --import tsx --require ./scripts/_server-only-shim.cjs scripts/import-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.0",
    "@sentry/nextjs": "^10.70.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "next": "^15.1.6",
    "openai": "^4.78.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-simple-maps": "^3.0.6",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
